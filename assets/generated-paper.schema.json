{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["metadata", "questions", "answers", "verification"],
  "properties": {
    "metadata": {"type": "object", "required": ["subject", "qualification", "exam_board", "level", "topic", "title", "time_allowed_minutes", "total_marks", "original_material_disclaimer"], "properties": {
      "subject": {"type": "string", "minLength": 1}, "qualification": {"type": "string", "minLength": 1}, "exam_board": {"type": "string", "minLength": 1}, "level": {"type": "string"}, "topic": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "time_allowed_minutes": {"type": "integer", "minimum": 1}, "total_marks": {"type": "integer", "minimum": 1}, "original_material_disclaimer": {"const": true}}, "additionalProperties": false},
    "questions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["number", "stem", "parts", "marks", "working_space", "diagram", "skills_tested"], "properties": {
      "number": {"type": "integer", "minimum": 1}, "stem": {"type": "string"}, "parts": {"type": "array", "items": {"type": "object", "required": ["label", "text", "marks"], "properties": {"label": {"type": "string"}, "text": {"type": "string"}, "marks": {"type": "integer", "minimum": 0}}, "additionalProperties": true}}, "marks": {"type": "integer", "minimum": 1}, "working_space": {"enum": ["small", "medium", "large"]}, "diagram": {"type": ["object", "null"]}, "skills_tested": {"type": "array", "items": {"type": "string"}}, "verification_data": {"type": "object"}}, "additionalProperties": false}},
    "answers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["question_number", "final_answer", "working", "mark_scheme", "acceptable_alternatives"], "properties": {"question_number": {"type": "integer"}, "final_answer": {"type": "string"}, "working": {"type": "array", "items": {"type": "string"}}, "mark_scheme": {"type": "array", "items": {"type": "string"}}, "acceptable_alternatives": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "verification": {"type": "object", "required": ["status", "checks"], "properties": {"status": {"enum": ["pending", "passed"]}, "checks": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  }, "additionalProperties": false
}
